{
  "name": "mediagenda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MediAgenda — Sistema de Agendamento de Consultas Médicas (ISPT, Engenharia Informática)",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -k -n API,WEB -c blue,green \"node --watch server/src/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/src/index.js",
    "seed": "node server/src/db/seed.js",
    "reset": "node server/src/db/seed.js --reset",
    "test": "node --test server/tests"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  }
}
